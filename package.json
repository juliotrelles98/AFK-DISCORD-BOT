{
  "name": "dj-voice-bot",
  "version": "1.0.0",
  "description": "Discord DJ Voice Bot - Local voice command recognition with faster-whisper",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "start": "node scripts/start.js",
    "start:whisper": "python3 python/whisper_server.py",
    "start:bot": "tsx src/index.ts",
    "dev": "node scripts/start.js",
    "build": "tsc",
    "deploy-commands": "tsx src/deploy-commands.ts",
    "typecheck": "tsc --noEmit",
    "test:parser": "tsx src/commands/parser.test.ts"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "@noble/ciphers": "^2.4.0",
    "@snazzah/davey": "^0.1.12",
    "@stablelib/xchacha20poly1305": "^2.0.1",
    "discord.js": "^14.16.0",
    "dotenv": "^16.4.0",
    "libsodium-wrappers": "^0.8.4",
    "opusscript": "^0.0.8",
    "play-dl": "^1.9.7",
    "prism-media": "^1.3.5",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
